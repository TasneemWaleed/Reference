struct shash {
    int base, mod, n;
    vector<int> p, prfx;

    shash(){}
    shash(string& s, int b, int m) {
        n = sz(s);
        base = b;
        mod = m;

        p.assign(n + 5, 1);
        prfx.assign(n + 5, 0);

        prfx[0] = s[0] - 'a' + 1;
        for (int i = 1; i < n; ++i) {
            p[i] = (p[i - 1] * b) % mod;
            prfx[i] = (prfx[i - 1] * b + (s[i] - 'a' + 1)) % mod;
        }
    }

    int get(int l, int r) {
        if (!l) return prfx[r];
        int rem = (prfx[l - 1] * p[r - l + 1]) % mod;
        return (prfx[r] - rem + mod) % mod;
    }

    int get() {
        return prfx[n - 1];
    }
};

struct doublehash {
    shash hash1, hash2;

    doublehash(string& s, int base1, int base2, int mod1, int mod2) {
        hash1 = shash(s, base1, mod1);
        hash2 = shash(s, base2, mod2);
    }

    pair<int, int> get(int l, int r) {
        return {hash1.get(l, r), hash2.get(l, r)};
    }

    pair<int, int> get() {
        return {hash1.get(), hash2.get()};
    }
};

